# Настройки инстанса команды. Скопируй в instances/<команда>/.env (это делает scripts/instance.sh new) и заполни.
# Пути DATA_DIR, BACKGROUNDS_DIR, MASCOT_DIR, PRONUNCIATION_FILE задаёт docker-compose.instance.yml, здесь их не пиши.

# --- Кто эта команда ---
# имя папки из profiles/ (general, engineering или своя); тексты, темы и ленты берутся оттуда
PROFILE=general
# площадки и возможности: * — всё; иначе список, например FEATURES=week (см. app/features.py)
FEATURES=*
# как канал подписан в кадре ролика и как его ищут в Telegram
BRAND_NAME=Your Brand
BRAND_HANDLE=@your_channel

# --- Telegram: у каждой команды СВОЙ бот (два инстанса с одним токеном будут мешать друг другу) ---
TELEGRAM_BOT_TOKEN=
# user id тех, кто модерирует (@userinfobot), через запятую
ADMIN_IDS=
TG_CHANNEL_ID=@your_channel
TG_CHANNEL_LINK=https://t.me/your_channel

# --- LLM и озвучка ---
LLM_PROVIDER=yandex
LLM_MODEL=yandexgpt/latest
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
TTS_PROVIDER=yandex
YANDEX_TTS_VOICE=alexander
YANDEX_TTS_ROLE=good
YANDEX_TTS_SPEED=1.0

# --- Сервер в РФ: тот же Cloudflare Worker, что у остальных инстансов (пусто = напрямую) ---
TELEGRAM_API_URL=
CF_PROXY_SECRET=

# --- YouTube: значения выдаёт scripts/youtube_auth.py под аккаунт этой команды (можно позже) ---
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_PRIVACY=public

PIXABAY_API_KEY=
RENDER_WORKERS=2

# --- Расписание этой команды ---
TG_DAYS=1,3,5
TG_TIME=12:00
PUBLISH_SLOTS=19:00
SCHEDULE_UTC_OFFSET=3
TOPICS_TIME=09:00
TOPICS_COUNT=3
AUTO_QUEUE=false
# true — бот присылает напоминания про ручные шаги (они написаны под автора проекта; для команды обычно false)
REMINDERS=false
HEARTBEAT_URL=
