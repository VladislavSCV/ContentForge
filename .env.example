# --- Telegram ---
# токен от @BotFather
TELEGRAM_BOT_TOKEN=
# твой user id (узнать у @userinfobot); можно несколько через запятую
ADMIN_IDS=
# бот должен быть админом канала с правом публикации
TG_CHANNEL_ID=@your_channel
TG_CHANNEL_LINK=https://t.me/your_channel
# как канал подписан в кадре ролика и как его ищут в Telegram
BRAND_NAME=Your Brand
BRAND_HANDLE=@your_channel

# --- LLM: yandex | deepseek | openai | anthropic ---
LLM_PROVIDER=yandex
# yandexgpt/latest (Pro) — заметно умнее; yandexgpt-5-lite/latest — дешевле, но путает смысл
LLM_MODEL=yandexgpt/latest
# Yandex AI Studio: API-ключ сервисного аккаунта и ID каталога
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
# OpenAI-совместимый шлюз для openai/deepseek, например https://api.deepseek.com/v1
LLM_BASE_URL=
LLM_API_KEY=
# только для LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# --- Озвучка: yandex (SpeechKit, тот же YANDEX_API_KEY) | elevenlabs ---
TTS_PROVIDER=yandex
# SpeechKit v3. Мужские: anton, kirill, alexander, ermil, zahar, filipp; женские: dasha, alena, jane, masha, lera
YANDEX_TTS_VOICE=alexander
# интонация: good (дружелюбно), neutral, strict; пусто — по умолчанию голоса
YANDEX_TTS_ROLE=good
YANDEX_TTS_SPEED=1.0

# --- ElevenLabs (только для TTS_PROVIDER=elevenlabs) ---
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=pNInz6obpgDQGcFmaJgB
ELEVENLABS_MODEL=eleven_multilingual_v2

# --- Cloudflare Worker для сервера в РФ (cloudflare/worker.js): Telegram, YouTube, LinkedIn ---
# Пусто = всё напрямую (бот не в РФ). Адрес вида https://contentops-proxy.<аккаунт>.workers.dev
TELEGRAM_API_URL=
# Тот же секрет — в переменной PROXY_SECRET Worker'а (Settings -> Variables, тип Secret)
CF_PROXY_SECRET=

# --- YouTube (значения выдаёт scripts/youtube_auth.py) ---
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_PRIVACY=public

# --- Стоковые видео для фона Shorts: бесплатный ключ на pixabay.com/api/docs. Пусто — анимированный градиент ---
PIXABAY_API_KEY=

# сколько вкладок Chromium снимают кадры параллельно — по числу ядер сервера
RENDER_WORKERS=2

# --- Рендер (опционально): шрифт субтитров, .ttf положи в assets/fonts ---
# SUBTITLE_FONT=Montserrat ExtraBold

# --- темы и очередь публикаций ---
# Telegram: дни недели (1 = понедельник) и время; YouTube: окна каждый день, не раньше поста в канале
TG_DAYS=1,3,5
TG_TIME=12:00
PUBLISH_SLOTS=19:00
# адрес пинга «бот жив» (healthchecks.io): если пинги прекратятся, сервис сам напишет тебе. Пусто — без сторожа
HEARTBEAT_URL=
# смещение местного времени от UTC, часы (Москва = 3)
SCHEDULE_UTC_OFFSET=3
# во сколько присылать подборку тем
TOPICS_TIME=09:00
TOPICS_COUNT=3
# true: ролик без замечаний автопроверки сам встаёт в очередь; с замечаниями ждёт тебя
AUTO_QUEUE=false
# итоги недели приходят по воскресеньям в это время
DIGEST_TIME=18:00
# токен только на чтение статистики YouTube (пишет scripts/youtube_auth.py --stats)
YOUTUBE_STATS_REFRESH_TOKEN=

# Сервер для scripts/deploy_remote.sh (адрес личный, в репозиторий не попадает)
DEPLOY_HOST=root@your.server.ip

# Профиль контента = папка profiles/<имя>/ (промпты, темы, ленты, флаги): engineering — инженерные темы,
# general — психология, наука, кризисы. Ленты берутся из профиля; SOURCES_FILE переопределяет. Старое имя CONTENT_PROFILE тоже работает.
PROFILE=engineering
# Площадки и возможности: * — всё; иначе список из linkedin,habr,devto,reddit,week,talk,longvideo (см. app/features.py)
FEATURES=*
